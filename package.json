{
  "name": "discount-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#theme.css": "./src/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production tsc && vite build && cp dist/index.html dist/200.html",
    "postbuild": "surge ./build --domain https://discount-calculator.surge.sh/",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.0.2",
    "@radix-ui/react-tabs": "1.0.4",
    "clsx": "2.1.0",
    "idb-keyval": "6.2.1",
    "money-clip": "3.0.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "6.22.1",
    "react-router-dom": "6.22.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.19",
    "@vitejs/plugin-react": "6.0.1",
    "daisyui": "5.5.19",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.3",
    "vite": "8.0.8",
    "vite-plugin-pwa": "1.2.0"
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "pnpm@11.0.4"
}
