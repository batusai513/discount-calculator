    "money-clip": "3.0.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "6.22.1",
    "react-router-dom": "6.22.1",
    "sonner": "1.4.3",
    "tailwind-merge": "3.5.0",
    "valibot": "0.30.0"
