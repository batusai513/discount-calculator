{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": { "browser": true, "es2020": true },
  "plugins": ["typescript", "react", "react-perf"],
  "categories": { "correctness": "warn" },
  "ignorePatterns": ["dist"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  }
}
